# SuperPOS backend — environment variables read by superpos_backend/settings.py.
# These are plain OS environment variables (settings.py does not load this file);
# export them via your shell, systemd unit, Docker env, or hosting panel.
# All have dev-safe defaults, so local development needs none of them.

# ── Django core — REQUIRED in production ─────────────────────────────────────
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
# Comma-separated hostnames the API is served on.
DJANGO_ALLOWED_HOSTS=pos.example.com

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=superpos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── CORS — REQUIRED in production ─────────────────────────────────────────────
# Comma-separated frontend origins (with scheme). When unset, ALL origins are
# allowed (dev-only behaviour).
CORS_ALLOWED_ORIGINS=https://app.example.com
